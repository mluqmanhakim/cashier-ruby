<h1>Add New Menu Item</h1>

<%= form_with(model: @menu_item, url: menu_items_path, local: true) do |f| %>
  <% if @menu_item.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(@menu_item.errors.count, "error") %> prohibited this menu item from being saved:</h2>

      <ul>
      <% @menu_item.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <%= f.label :name %><br />
    <%= f.text_field :name, autofocus: true %>
  </div>

  <div class="field">
    <%= f.label :price %><br />
    <%= f.number_field :price, step: 0.01 %>
  </div>

  <div class="actions">
    <%= f.submit "Save Menu Item" %>
  </div>
<% end %>

<%= link_to 'Back', menu_items_path %>
